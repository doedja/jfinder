# ===========================================
# JFinder Configuration (Go port)
# ===========================================

# Required: LLM provider configuration
# LLM_PROVIDER: "deepseek" (default) or "openrouter"
LLM_PROVIDER=deepseek

# LLM_API_KEY: provider API key
# DeepSeek:   https://platform.deepseek.com/api_keys
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# LLM_MODEL: model id used by the chosen provider
# DeepSeek default:   deepseek-chat
# OpenRouter default: qwen/qwen-2.5-72b-instruct
LLM_MODEL=deepseek-chat

# Optional: Scopus API (falls back to OpenAlex if unset, which needs no key)
# Get a key at https://dev.elsevier.com/
SCOPUS_API_KEY=

# Optional: WebShare proxy list URL for download fallback
PROXY_URL=

# Optional: Anna's Archive download source. Either key enables it.
ANNAS_API_KEY=
RAPIDAPI_KEY=

# Storage
DOWNLOAD_DIR=./downloads
MAX_UPLOAD_SIZE=16777216
TASK_TTL_MS=3600000

# Server
HOST=0.0.0.0
PORT=3000

# SEO and canonical
BASE_URL=https://jfinder.doedja.com

# Optional: Umami analytics
UMAMI_WEBSITE_ID=
UMAMI_SRC=

# Optional: log level (debug, info, warn, error). Default info.
LOG_LEVEL=info

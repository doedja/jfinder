---
import Layout from '../layouts/Layout.astro';
import UnifiedCapabilities from '../components/UnifiedCapabilities.astro';
---

<Layout title="JFinder — Features">
  <main class="main">
    <header class="header">
      <div class="header-inner container">
        <a href="/" class="header-brand">
          <span class="brand-symbol">◈</span>
          <span class="brand-name">JFinder</span>
        </a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="theme-icon theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="theme-icon theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </header>

    <div class="content container">
      <div class="page-header">
        <a href="/" class="back-link">← Back to JFinder</a>
        <h1 class="page-title">Features</h1>
        <p class="page-subtitle">Explore all features available in JFinder</p>
      </div>

      <div class="capabilities-wrapper">
        <UnifiedCapabilities />
      </div>
    </div>
  </main>
</Layout>

<style>
  .main {
    min-height: 100vh;
    background: var(--color-bg);
  }

  .header {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .brand-symbol {
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .content {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .page-header {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-md);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .capabilities-wrapper {
    max-width: 900px;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-text-muted);
    background: var(--color-bg-warm);
  }

  .theme-icon-dark {
    display: none;
  }

  :global([data-theme="dark"]) .theme-icon-light {
    display: none;
  }

  :global([data-theme="dark"]) .theme-icon-dark {
    display: block;
  }
</style>

<script>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const newTheme = isDark ? 'light' : 'dark';
    if (newTheme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    localStorage.setItem('jfinder-theme', newTheme);
  });

  // Auto-expand capabilities on this page
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.capabilities-section');
    const toggle = document.querySelector('.capabilities-toggle');
    if (section && !section.classList.contains('expanded')) {
      section.classList.add('expanded');
      toggle?.setAttribute('aria-expanded', 'true');
    }
  });
</script>
